{
    "name": "restruct/silverstripe-shortcodable",
    "description": "A shortcode button and dialog for the Silverstripe WYSIWYG editor: CMS editors pick, fill in and edit shortcodes, shown as placeholder images, and developers make any class or DataObject shortcodable.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "silverstripe-cms",
        "shortcode",
        "shortcodes",
        "tinymce",
        "wysiwyg",
        "htmleditor"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        },
        {
            "name": "Shea Dawson",
            "email": "shea@livesource.co.nz"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/vendor-plugin": "^2 || ^3",
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/admin": "^2 || ^3",
        "restruct/silverstripe-simpler": "~0.2 || ^1"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "suggest": {
        "silverstripe/htmleditor-tinymce": "Required on Silverstripe 6: TinyMCE is a separate module there, and without it the shortcode button is not added to any editor"
    },
    "replace": {
        "sheadawson/silverstripe-shortcodable": "*"
    },
    "autoload": {
        "psr-4": {
            "Shortcodable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shortcodable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
